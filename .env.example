# Шаблон .env: скопируйте в .env и заполните нужное. Реальные переменные
# окружения (PM2, docker, shell) приоритетнее значений из файла.
# Другой путь к файлу — только через окружение: AIPANEL_ENV_FILE=/path/to/env
# (none — не читать файл).
# AIPANEL_ENV_FILE=

# Локальный HTTP-сервер
HOST=127.0.0.1
PORT=8765

# Внешний origin reverse proxy (https://panel.example); включает remote-режим
# и bind на 0.0.0.0.
PUBLIC_ORIGIN=
# Обязателен в remote-режиме (при заданном PUBLIC_ORIGIN или HOST вне
# loopback): токен доступа к панели (минимум 16 символов).
# Сгенерировать: openssl rand -hex 24
AIPANEL_AUTH_TOKEN=
# Доп. hostname'ы, которые сервер считает «своими» (для проверки Host,
# защита от DNS rebinding), через запятую. Loopback и хост PUBLIC_ORIGIN
# разрешены всегда; X-Forwarded-Host учитывается только при TRUST_PROXY=true.
ALLOWED_HOSTS=
# true, если панель стоит за reverse proxy и можно доверять
# X-Forwarded-Host/X-Forwarded-Proto (иначе их может подставить клиент).
TRUST_PROXY=false
# Явный CORS allowlist через запятую; по умолчанию cross-origin запрещён.
ALLOWED_ORIGINS=

# Необязательный переносимый master key хранилища: ровно 64 hex-символа
# (openssl rand -hex 32). Пусто — ключ генерируется при первом запуске
# в <AIPANEL_DATA_DIR>/store.db.key.
AIPANEL_MASTER_KEY=

# Каталоги данных (store.db, ключ, кэш рейтинга) и логов. Пусто — data/ и
# logs/ в корне проекта; относительные пути считаются от корня проекта.
AIPANEL_DATA_DIR=
AIPANEL_LOG_DIR=

# Детальное логирование запросов к провайдерам (true/false)
AIPANEL_PROVIDER_DEBUG=false

# Файл кэша рейтинга для кодинга (по умолчанию <AIPANEL_DATA_DIR>/coding-ratings.json)
# AIPANEL_CODING_CACHE_PATH=

# OAuth Antigravity (нужны только для этой интеграции)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Часы высвобождения пула ресурсов AgentRouter (модели Claude/GPT) —
# через запятую, в UTC. По графику провайдера: Пекин 10:00/19:00
# = UTC 02:00/11:00. Якорный часовой пояс графика — Asia/Shanghai.
# Можно переопределить и в настройках провайдера (поле «Окна сброса»).
AGENTROUTER_RELEASE_HOURS_UTC=2,11
