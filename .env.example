# Локальный HTTP-сервер
HOST=127.0.0.1
PORT=8765

# Явный CORS allowlist через запятую; по умолчанию cross-origin запрещён.
ALLOWED_ORIGINS=
PUBLIC_ORIGIN=

# Обязательный секрет production-класса для encrypted store.
# Требование fail-fast будет технически введено на этапе 4.
# Ровно 64 шестнадцатеричных символа (32 байта).
AIPANEL_MASTER_KEY=replace-with-64-hex-characters

# OAuth Antigravity (нужны только для этой интеграции)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Детальное логирование взаимодействия с внешними провайдерами (true/false)
AIPANEL_PROVIDER_DEBUG=true

# Часы высвобождения пула ресурсов AgentRouter (модели Claude/GPT) —
# через запятую, в UTC. По графику провайдера от 10.09: Пекин 0:00/8:00/16:00
# = UTC 16:00/0:00/8:00. Якорный часовой пояс графика — Asia/Shanghai.
AGENTROUTER_RELEASE_HOURS_UTC=0,8,16
