# AI Панель — .env
# Скопируйте в .env при необходимости

# Порт локального сервера (по умолчанию 8765)
PORT=8765

# --- Примечание ---
# API-ключ xKiro и настройки OmniRoute (URL, ключ) вводятся
# через диалог «⚙ Настройки» в панели и хранятся в localStorage браузера.
# Сервер не читает XKIRO_*/OMNIROUTE_* из .env — ключи не попадают на сервер.
