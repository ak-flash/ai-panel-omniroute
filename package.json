{
  "name": "ai-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Дашборд статистики AI-провайдеров (xKiro), каталог моделей и combo OmniRoute",
  "scripts": {
    "lint": "eslint . --config config/eslint.config.js --max-warnings=0",
    "lint:fix": "eslint . --config config/eslint.config.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint public/css/**/*.css",
    "stylelint:fix": "stylelint public/css/**/*.css --fix",
    "test:playwright": "playwright test --config config/playwright.config.js",
    "test:playwright:headed": "playwright test --config config/playwright.config.js --headed",
    "start": "node server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "test:ci": "node --test --experimental-test-coverage \"test/unit/*.test.js\" \"test/integration/*.test.js\" --test-coverage-include=\"src/**/*.js\" --test-coverage-include=\"providers/**/*.js\" --test-coverage-include=\"public/**/*.js\" --test-coverage-lines=96 --test-coverage-branches=89 --test-coverage-functions=93 --test-reporter=spec",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:security": "npm run test:unit -- --test-name-pattern security",
    "check:secrets": "node scripts/check-secrets.js",
    "check:types": "tsc --noEmit",
    "lint:docs": "node scripts/check-docs.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22"
    }
  },
  "dependencies": {
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.9.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "^7.0.2"
  }
}
